{
  "info": {
    "name": "SkyAlert Mini API",
    "description": "Colección de la API serverless de SkyAlert Lite (clients, devices, users, seismic).\n\nAuth: header 'Authorization: {{authScheme}} {{accessToken}}'.\n- App legacy: authScheme = JWT, accessToken = accessToken.token del backend legacy.\n- Web Cognito: authScheme = Bearer, accessToken = JWT de Cognito.\n\nVariables requeridas: baseUrl, authScheme, accessToken.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "Authorization", "type": "string" },
      { "key": "value", "value": "{{authScheme}} {{accessToken}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Validación genérica a nivel colección",
          "pm.test('status is not 401 (token válido)', function () {",
          "  pm.expect(pm.response.code, 'esperaba token válido').to.not.eql(401);",
          "});",
          "console.log('HTTP', pm.response.code, pm.response.text());"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://n97qy0xdw3.execute-api.us-east-1.amazonaws.com", "type": "string" },
    { "key": "authScheme", "value": "JWT", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "clientId", "value": "", "type": "string" },
    { "key": "registrationId", "value": "", "type": "string" },
    { "key": "deviceId", "value": "", "type": "string" },
    { "key": "username", "value": "", "type": "string" },
    { "key": "uuid", "value": "ska-L0z4AD", "type": "string" },
    { "key": "reservedFor", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Legacy app flow (webview)",
      "description": "Flujo del webview de clients con token legacy (authScheme=JWT).\nOrden recomendado: 1) List my devices (auto-provisiona) → 2) Lookup device → 3) Register device.",
      "item": [
        {
          "name": "1. List my devices (auto-provision)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/devices", "host": ["{{baseUrl}}"], "path": ["devices"] },
            "description": "Primer endpoint del webview. Auto-provisiona el customer legacy y devuelve 200 con sus devices (vacío si es nuevo)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('respuesta con items', () => pm.expect(pm.response.json()).to.have.property('items'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Lookup device by uuid",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/devices/lookup/{{uuid}}", "host": ["{{baseUrl}}"], "path": ["devices", "lookup", "{{uuid}}"] },
            "description": "Comprueba si el uuid se puede dar de alta (canRegister = status === 'inactive')."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  pm.test('canRegister === (status === inactive)', () => pm.expect(b.canRegister).to.eql(b.status === 'inactive'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Register device (requires inactive)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/devices", "host": ["{{baseUrl}}"], "path": ["devices"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uuid\": \"{{uuid}}\",\n  \"name\": \"Mi sensor\",\n  \"address\": \"Av. Reforma 123, CDMX\",\n  \"latitude\": 19.400317,\n  \"longitude\": -99.28739\n}"
            },
            "description": "Da de alta el device en el tenant del usuario. Legacy omite clientId (usa el suyo). Requiere status_device ausente o 'inactive' (si no → 400). latitude/longitude requeridos."
          }
        }
      ]
    },
    {
      "name": "Clients",
      "item": [
        {
          "name": "Create client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/clients", "host": ["{{baseUrl}}"], "path": ["clients"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Empresa Demo\",\n  \"email\": \"contacto@demo.com\",\n  \"phone\": \"+525512345678\",\n  \"address\": \"CDMX\"\n}"
            }
          }
        },
        {
          "name": "List clients",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/clients?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["clients"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "lastKey", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get client",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/clients/{{clientId}}", "host": ["{{baseUrl}}"], "path": ["clients", "{{clientId}}"] }
          }
        },
        {
          "name": "Update client",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/clients/{{clientId}}", "host": ["{{baseUrl}}"], "path": ["clients", "{{clientId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Empresa Demo (editada)\",\n  \"phone\": \"+525599998888\",\n  \"address\": \"Monterrey\",\n  \"status\": \"active\"\n}"
            }
          }
        },
        {
          "name": "Delete client (soft)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/clients/{{clientId}}", "host": ["{{baseUrl}}"], "path": ["clients", "{{clientId}}"] }
          }
        }
      ]
    },
    {
      "name": "Devices",
      "item": [
        {
          "name": "Lookup device",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/devices/lookup/{{uuid}}", "host": ["{{baseUrl}}"], "path": ["devices", "lookup", "{{uuid}}"] },
            "description": "Verifica un device físico por uuid en gps-tracker-devices.\nResponde { uuid, reservedFor, statusDevice, canRegister, latitude, longitude, exists }.\ncanRegister = true si statusDevice está ausente o es 'inactive'. Accesible por cualquier rol."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  pm.test('canRegister = statusDevice ausente o inactive', function () {",
                  "    pm.expect(b.canRegister).to.eql(b.statusDevice == null || b.statusDevice === 'inactive');",
                  "  });",
                  "  pm.collectionVariables.set('reservedFor', b.reservedFor || '');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register device",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/devices", "host": ["{{baseUrl}}"], "path": ["devices"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uuid\": \"{{uuid}}\",\n  \"name\": \"Sensor Planta Baja\",\n  \"address\": \"Av. Reforma 123, CDMX\",\n  \"latitude\": 19.400317,\n  \"longitude\": -99.28739\n}"
            },
            "description": "Registra un device vinculado a un cliente.\n- Solo si status_device está ausente o 'inactive' (si no → 400).\n- Legacy (rol client): el clientId del body se ignora, se fuerza su propio tenant (legacy#<sub>); por eso no se envía.\n- Admin/internal: deben enviar clientId en el body.\n- Campos: uuid y name requeridos; latitude/longitude requeridos (rango válido); address opcional."
          }
        },
        {
          "name": "List devices",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/devices?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["devices"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "clientId", "value": "{{clientId}}", "disabled": true },
                { "key": "lastKey", "value": "", "disabled": true }
              ]
            },
            "description": "Lista los devices del tenant.\n- Legacy (rol client): primer endpoint del webview; auto-provisiona el customer (crea CLIENT legacy#<sub> si no existe) y devuelve 200 con sus devices (vacío si es nuevo).\n- Admin/internal: ven todos; ?clientId= filtra una compañía."
          }
        },
        {
          "name": "Get device",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/devices/{{registrationId}}", "host": ["{{baseUrl}}"], "path": ["devices", "{{registrationId}}"] }
          }
        },
        {
          "name": "Update device",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/devices/{{registrationId}}", "host": ["{{baseUrl}}"], "path": ["devices", "{{registrationId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Sensor Recepci\u00f3n\",\n  \"address\": \"Insurgentes Sur 1000, CDMX\",\n  \"latitude\": 19.3621,\n  \"longitude\": -99.1766\n}" },
            "description": "Actualizaci\u00f3n PARCIAL: solo se modifican los campos presentes (al menos uno requerido). Campos opcionales: name (1-200), address (max 500), latitude (-90..90), longitude (-180..180). Body vac\u00edo -> 400. Respuesta normalizada."
          }
        },
        {
          "name": "Delete device (soft)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/devices/{{registrationId}}", "host": ["{{baseUrl}}"], "path": ["devices", "{{registrationId}}"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@demo.com\",\n  \"name\": \"Juan P\u00e9rez\",\n  \"role\": \"client\",\n  \"clientId\": \"{{clientId}}\"\n}"
            }
          }
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "paginationToken", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get user",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/users/{{username}}", "host": ["{{baseUrl}}"], "path": ["users", "{{username}}"] }
          }
        },
        {
          "name": "Update user role",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/users/{{username}}/role", "host": ["{{baseUrl}}"], "path": ["users", "{{username}}", "role"] },
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"collaborator\",\n  \"clientId\": \"{{clientId}}\"\n}" }
          }
        },
        {
          "name": "Set user status",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/users/{{username}}/status", "host": ["{{baseUrl}}"], "path": ["users", "{{username}}", "status"] },
            "body": { "mode": "raw", "raw": "{\n  \"action\": \"disable\"\n}" }
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/users/{{username}}", "host": ["{{baseUrl}}"], "path": ["users", "{{username}}"] }
          }
        }
      ]
    },
    {
      "name": "Seismic",
      "item": [
        {
          "name": "Get latest reading",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/seismic/{{deviceId}}/latest", "host": ["{{baseUrl}}"], "path": ["seismic", "{{deviceId}}", "latest"] }
          }
        },
        {
          "name": "List readings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/seismic/{{deviceId}}?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["seismic", "{{deviceId}}"],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "from", "value": "2026-01-01T00:00:00Z", "disabled": true },
                { "key": "to", "value": "2026-01-31T23:59:59Z", "disabled": true },
                { "key": "lastKey", "value": "", "disabled": true }
              ]
            }
          }
        }
      ]
    }
  ]
}
